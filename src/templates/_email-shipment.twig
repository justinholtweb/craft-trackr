{#
    Trackr's own "your order has shipped" email. Override it with a site template in
    Settings → Trackr → Notifications when the store has its own email design.
#}
<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'Your order has shipped'|t('trackr') }}</title>
</head>
<body style="margin:0;padding:24px;background:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:{{ styles.text }};">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width:560px;margin:0 auto;border-collapse:collapse;">
        <tr>
            <td style="padding:0 0 16px;font-size:20px;font-weight:600;">
                {{ 'Your order is on its way'|t('trackr') }}
            </td>
        </tr>
        <tr>
            <td style="padding:0 0 20px;font-size:15px;line-height:1.6;">
                {{ 'Order {number} has shipped. Here’s how to follow it.'|t('trackr', {
                    number: craft.trackr.orderNumber(order)
                }) }}
            </td>
        </tr>
        <tr>
            <td>{{ craft.trackr.widget(order) }}</td>
        </tr>
    </table>
</body>
</html>
