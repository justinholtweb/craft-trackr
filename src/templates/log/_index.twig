{% extends '_layouts/cp' %}
{% do view.registerAssetBundle('justinholtweb\\trackr\\web\\assets\\cp\\CpAsset') %}
{% import '_includes/forms' as forms %}

{% set title = 'Log'|t('trackr') %}
{% set selectedSubnavItem = 'log' %}

{% block actionButton %}
    {% if currentUser.can('trackr-manageLog') %}
        <button type="button" class="btn" id="trackr-prune">{{ 'Prune'|t('trackr') }}</button>
        <button type="button" class="btn caution" id="trackr-clear">{{ 'Clear'|t('trackr') }}</button>
    {% endif %}
{% endblock %}

{% block content %}
    <form method="get" action="{{ url('trackr/log') }}" class="flex trackr-toolbar">
        <div class="trackr-grow">
            {{ forms.text({ name: 'search', value: filters.search, placeholder: 'Search'|t('trackr'), class: 'text fullwidth' }) }}
        </div>
        <div class="trackr-col">
            {{ forms.select({
                name: 'level',
                value: filters.level,
                options: [
                    { label: 'Any level'|t('trackr'), value: '' },
                    { label: 'Info'|t('trackr'), value: 'info' },
                    { label: 'Warning'|t('trackr'), value: 'warning' },
                    { label: 'Error'|t('trackr'), value: 'error' }
                ]
            }) }}
        </div>
        <div><button type="submit" class="btn">{{ 'Filter'|t('trackr') }}</button></div>
    </form>

    {% if entries|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ 'When'|t('trackr') }}</th>
                    <th scope="col">{{ 'Action'|t('trackr') }}</th>
                    <th scope="col">{{ 'Summary'|t('trackr') }}</th>
                    <th scope="col">{{ 'Source'|t('trackr') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in entries %}
                    <tr>
                        <td class="nowrap">{{ entry.dateCreated ? entry.dateCreated|datetime('short') : '—' }}</td>
                        <td>
                            <span class="status {{ entry.getLevelColor() }}"></span>
                            <code>{{ entry.action }}</code>
                        </td>
                        <td><a href="{{ url('trackr/log/' ~ entry.id) }}">{{ entry.summary }}</a></td>
                        <td class="light">{{ entry.source ?? '—' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% set pages = (total / perPage)|round(0, 'ceil') %}
        {% if pages > 1 %}
            <div class="flex trackr-pager">
                {% if page > 1 %}<a class="btn" href="{{ url('trackr/log', filters|merge({ page: page - 1 })) }}">{{ '← Previous'|t('trackr') }}</a>{% endif %}
                <span class="light">{{ 'Page {page} of {pages}'|t('trackr', { page: page, pages: pages }) }}</span>
                {% if page < pages %}<a class="btn" href="{{ url('trackr/log', filters|merge({ page: page + 1 })) }}">{{ 'Next →'|t('trackr') }}</a>{% endif %}
            </div>
        {% endif %}
    {% else %}
        <div class="pane"><p>{{ 'Nothing logged yet.'|t('trackr') }}</p></div>
    {% endif %}
{% endblock %}

{% js %}
(function() {
    function run(action, message) {
        Craft.sendActionRequest('POST', action)
            .then(function(response) {
                Craft.cp.displayNotice(response.data.message || message);
                window.location.reload();
            })
            .catch(function() { Craft.cp.displayError({{ 'That didn’t work.'|t('trackr')|json_encode|raw }}); });
    }

    document.getElementById('trackr-prune')?.addEventListener('click', function() {
        run('trackr/log/prune', {{ 'Pruned.'|t('trackr')|json_encode|raw }});
    });

    document.getElementById('trackr-clear')?.addEventListener('click', function() {
        if (!confirm({{ 'Delete the entire log?'|t('trackr')|json_encode|raw }})) { return; }
        run('trackr/log/clear', {{ 'Cleared.'|t('trackr')|json_encode|raw }});
    });
})();
{% endjs %}
