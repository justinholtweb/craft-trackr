{% js %}
(function() {
    var previewFields = [
        'widgetTitle', 'widgetLayout', 'widgetAccentColor', 'widgetTextColor', 'widgetMutedColor',
        'widgetBackgroundColor', 'widgetBorderColor', 'widgetButtonTextColor', 'widgetRadius',
        'widgetButtonLabel', 'widgetFooterText'
    ];
    var previewSwitches = [
        'widgetShowStatus', 'widgetShowShipDate', 'widgetShowService',
        'widgetShowProviderLogo', 'widgetShowTrackButton'
    ];

    function refreshPreview() {
        var target = document.getElementById('trackr-widget-preview');
        if (!target) { return; }

        var settings = {};

        previewFields.forEach(function(field) {
            var el = document.getElementById(field);
            if (el) { settings[field] = el.value; }
        });

        previewSwitches.forEach(function(field) {
            var el = document.getElementById(field);
            if (el) { settings[field] = el.checked ? 1 : 0; }
        });

        Craft.sendActionRequest('POST', 'trackr/settings/preview-widget', { data: { settings: settings } })
            .then(function(response) { target.innerHTML = response.data.html; })
            .catch(function() { target.textContent = {{ 'Preview unavailable.'|t('trackr')|json_encode|raw }}; });
    }

    document.getElementById('trackr-refresh-preview').addEventListener('click', refreshPreview);
    refreshPreview();

    document.querySelectorAll('[data-trackr-create-status]').forEach(function(button) {
        button.addEventListener('click', function() {
            var note = document.getElementById('trackr-status-note');
            button.classList.add('loading');

            Craft.sendActionRequest('POST', 'trackr/settings/create-status', {
                data: {
                    handle: button.getAttribute('data-trackr-create-status'),
                    name: button.getAttribute('data-name')
                }
            })
                .then(function(response) {
                    note.textContent = response.data.message;
                    if (response.data.success) {
                        Craft.cp.displayNotice(response.data.message);
                        window.location.reload();
                    }
                })
                .catch(function() { note.textContent = {{ 'Couldn’t create that status.'|t('trackr')|json_encode|raw }}; })
                .finally(function() { button.classList.remove('loading'); });
        });
    });

    var tokenButton = document.getElementById('trackr-generate-token');
    if (tokenButton) {
        tokenButton.addEventListener('click', function() {
            Craft.sendActionRequest('POST', 'trackr/settings/generate-token')
                .then(function(response) {
                    var input = document.getElementById('apiToken');
                    if (input) { input.value = response.data.token; }
                    document.getElementById('trackr-token-note').textContent =
                        {{ 'Generated — save the settings to keep it.'|t('trackr')|json_encode|raw }};
                })
                .catch(function() {
                    document.getElementById('trackr-token-note').textContent =
                        {{ 'Couldn’t generate a token.'|t('trackr')|json_encode|raw }};
                });
        });
    }
})();
{% endjs %}
