    {{ forms.textField({ label: 'Background'|t('trackr'), id: 'widgetBackgroundColor', name: 'widgetBackgroundColor', value: settings.widgetBackgroundColor, size: 9, class: 'code' }) }}
    {{ forms.textField({ label: 'Border'|t('trackr'), id: 'widgetBorderColor', name: 'widgetBorderColor', value: settings.widgetBorderColor, size: 9, class: 'code' }) }}
    {{ forms.textField({ label: 'Button text'|t('trackr'), id: 'widgetButtonTextColor', name: 'widgetButtonTextColor', value: settings.widgetButtonTextColor, size: 9, class: 'code' }) }}
    {{ forms.textField({ label: 'Corner radius'|t('trackr'), id: 'widgetRadius', name: 'widgetRadius', value: settings.widgetRadius, size: 6, class: 'code' }) }}
</div>

{{ forms.checkboxField({ label: 'Show the delivery status'|t('trackr'), id: 'widgetShowStatus', name: 'widgetShowStatus', checked: settings.widgetShowStatus }) }}
