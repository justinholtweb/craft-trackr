{% do view.registerAssetBundle('justinholtweb\\trackr\\web\\assets\\cp\\CpAsset') %}
{# Field names carry no `settings[…]` prefix: `craft\base\Plugin::settingsResponse()` runs this
   template's output through `View::namespaceInputs(…, 'settings')`, so a name written as
   `settings[foo]` here posts as `settings[settings][foo]` and saves nothing at all — the screen
   looks perfect, Craft reports "Plugin settings saved", and every edit is silently discarded. #}
{% import '_includes/forms' as forms %}

{% set isPro = plugin.isPro() %}
{% set commerceReady = craft.app.plugins.isPluginEnabled('commerce') %}
{% set statusOptions = commerceReady ? plugin.statuses.getStatusOptions() : {} %}

{% set statusList = [{ label: 'Leave the status alone'|t('trackr'), value: '' }] %}
{% for handle, name in statusOptions %}
    {% set statusList = statusList|merge([{ label: name, value: handle }]) %}
{% endfor %}

{% if not commerceReady %}
    <div class="pane">
        <p class="error">{{ 'Craft Commerce is not installed or enabled. Trackr needs it to do anything.'|t('trackr') }}</p>
    </div>
{% endif %}

{% if not isPro %}
    <div class="pane trackr-callout">
        <p>
            <strong>{{ 'You’re running Trackr Lite.'|t('trackr') }}</strong>
            {{ 'Item-level tracking, partial shipments, carrier auto-detection, custom carriers, the push API, watched-folder import, delivery notifications and the activity log are Pro. Their settings are shown below but have no effect until you upgrade.'|t('trackr') }}
        </p>
    </div>
{% endif %}

{# ------------------------------------------------------------------ #}
<h2>{{ 'Fulfilment'|t('trackr') }}</h2>

<div class="pane">
    <p class="light">
        {{ 'Commerce has no shipped status of its own. Pick the statuses an order should move to as tracking is added — or have Trackr create them.'|t('trackr') }}
    </p>

    {{ forms.selectField({
        label: 'Shipped order status'|t('trackr'),
        instructions: 'Where an order goes once everything on it has shipped.'|t('trackr'),
        id: 'shippedStatusHandle',
        name: 'shippedStatusHandle',
        options: statusList,
        value: settings.shippedStatusHandle
    }) }}

    {{ forms.selectField({
        label: 'Partially shipped order status'|t('trackr'),
        instructions: 'Where an order sits while some of it is still to go. Pro.'|t('trackr'),
        id: 'partiallyShippedStatusHandle',
        name: 'partiallyShippedStatusHandle',
        options: statusList,
        value: settings.partiallyShippedStatusHandle,
        disabled: not isPro
    }) }}

    {{ forms.selectField({
        label: 'Delivered order status'|t('trackr'),
        instructions: 'Where an order goes once every shipment on it is marked delivered. Pro.'|t('trackr'),
        id: 'deliveredStatusHandle',
        name: 'deliveredStatusHandle',
        options: statusList,
        value: settings.deliveredStatusHandle,
        disabled: not isPro
    }) }}

    {% if currentUser.admin and craft.app.config.general.allowAdminChanges %}
        <div class="field">
            <div class="buttons">
                <button type="button" class="btn" data-trackr-create-status="shipped" data-name="{{ 'Shipped'|t('trackr') }}">
                    {{ 'Create a “Shipped” status'|t('trackr') }}
                </button>
                <button type="button" class="btn" data-trackr-create-status="partiallyShipped" data-name="{{ 'Partially shipped'|t('trackr') }}">
                    {{ 'Create a “Partially shipped” status'|t('trackr') }}
                </button>
                <button type="button" class="btn" data-trackr-create-status="delivered" data-name="{{ 'Delivered'|t('trackr') }}">
                    {{ 'Create a “Delivered” status'|t('trackr') }}
                </button>
            </div>
            <p class="light trackr-mt-xs" id="trackr-status-note"></p>
        </div>
    {% endif %}
</div>

{{ forms.lightswitchField({
    label: 'Move the order when tracking is added'|t('trackr'),
    instructions: 'Off records tracking without touching the order’s status.'|t('trackr'),
    id: 'updateStatusOnTracking',
    name: 'updateStatusOnTracking',
    on: settings.updateStatusOnTracking
}) }}

{{ forms.lightswitchField({
    label: 'Count units for partial shipments'|t('trackr'),
    instructions: 'Holds an order at the partially shipped status until every shippable unit is covered. Pro.'|t('trackr'),
    id: 'partialShipmentsEnabled',
    name: 'partialShipmentsEnabled',
    on: settings.partialShipmentsEnabled,
    disabled: not isPro
}) }}

{{ forms.lightswitchField({
    label: 'Write a note on the order history'|t('trackr'),
    instructions: 'Records the carrier and tracking number against the order, even when the status does not move.'|t('trackr'),
    id: 'addOrderHistoryNote',
    name: 'addOrderHistoryNote',
    on: settings.addOrderHistoryNote
}) }}

{{ forms.selectField({
    label: 'Default carrier'|t('trackr'),
    instructions: 'Pre-selected on the order screen.'|t('trackr'),
    id: 'defaultProvider',
    name: 'defaultProvider',
    options: plugin.providers.getSelectOptions(),
    value: settings.defaultProvider
}) }}

{{ forms.selectField({
    label: 'New shipments start as'|t('trackr'),
    id: 'defaultShipmentStatus',
    name: 'defaultShipmentStatus',
    options: plugin.shipmentStatusOptions(),
    value: settings.defaultShipmentStatus
}) }}

{{ forms.lightswitchField({
    label: 'Detect the carrier from the tracking number'|t('trackr'),
    instructions: 'Used when a CSV row or an API call gives a tracking number but no carrier. Trackr only guesses when exactly one carrier’s pattern matches. Pro.'|t('trackr'),
    id: 'autoDetectProvider',
    name: 'autoDetectProvider',
    on: settings.autoDetectProvider,
    disabled: not isPro
}) }}

{{ forms.textField({
    label: 'Preferred country'|t('trackr'),
    instructions: 'Two-letter code. Carriers from this country sort to the top of the picker.'|t('trackr'),
    id: 'preferredCountry',
    name: 'preferredCountry',
    value: settings.preferredCountry,
    size: 6,
    placeholder: 'US'
}) }}

{# ------------------------------------------------------------------ #}
